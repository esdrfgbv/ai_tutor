APP_NAME=JNV Sainik AI Prep
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=14
# Set DATABASE_URL directly, OR provide individual SUPABASE_DB_* fields:
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# SUPABASE_DB_HOST=db.xxx.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your-password
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173,https://ai-tutor-beta-black.vercel.app,https://ai-tutor-git-master-koutuhal.vercel.app
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=../vector_db/chroma
UPLOAD_DIR=../uploads
SOURCE_ROOT=..
BOOTSTRAP_ADMIN_EMAIL=admin@jnvprep.local
BOOTSTRAP_ADMIN_PASSWORD=change-me
